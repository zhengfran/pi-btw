{
  "name": "@zhengfran/pi-btw",
  "version": "0.1.0",
  "description": "Persistent read-only side conversations for Pi, with independent session breakout",
  "type": "module",
  "license": "MIT",
  "author": "Zheng Zhicheng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengfran/pi-btw.git"
  },
  "bugs": {
    "url": "https://github.com/zhengfran/pi-btw/issues"
  },
  "homepage": "https://github.com/zhengfran/pi-btw#readme",
  "keywords": [
    "pi-package",
    "pi",
    "btw",
    "side-chat",
    "read-only"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
